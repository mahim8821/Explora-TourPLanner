rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // ─── Helper Functions ──────────────────────────────────────────────────
    function isAuthenticated() {
      return request.auth != null;
    }

    function isOwner(uid) {
      return isAuthenticated() && request.auth.uid == uid;
    }

    // Server-controlled role extraction:
    // Prioritize Firebase Auth Custom Claims (`request.auth.token.role`),
    // with fallback to the user's Firestore profile for development elasticity.
    function getRole() {
      return request.auth.token.role != null
        ? request.auth.token.role
        : (exists(/databases/$(database)/documents/users/$(request.auth.uid))
            ? get(/databases/$(database)/documents/users/$(request.auth.uid)).data.role
            : 'traveler');
    }

    function isAdmin() {
      return isAuthenticated() && getRole() == 'admin';
    }

    function isOperator() {
      return isAuthenticated() && (getRole() == 'operator' || getRole() == 'admin');
    }

    function isModerator() {
      return isAuthenticated() && (getRole() == 'moderator' || getRole() == 'admin');
    }

    // ─── users/{uid} ──────────────────────────────────────────────────────
    match /users/{uid} {
      // Travelers can read their own profile; staff can read profiles as needed
      allow read: if isOwner(uid) || isOperator() || isModerator() || isAdmin();

      // Creation on sign-up: default role must be 'traveler' or omitted
      allow create: if isOwner(uid) &&
        (!('role' in request.resource.data) || request.resource.data.role in ['traveler', 'user']);

      // Clients can update their own profile fields, but CANNOT elevate their own role.
      // Only server-side Admin SDK or Admin role can update roles.
      allow update: if (isOwner(uid) &&
                        (!('role' in request.resource.data) || request.resource.data.role == resource.data.role))
                    || isAdmin();

      // Only admins can delete user documents
      allow delete: if isAdmin();
    }

    // ─── trips/{tripId} ───────────────────────────────────────────────────
    match /trips/{tripId} {
      // Public / Travelers can only read Published tours.
      // Operators can read their own drafts; Admins can read all.
      allow read: if isAuthenticated() && (
        resource.data.status == 'Published' ||
        resource.data.operatorId == request.auth.uid ||
        isAdmin()
      );

      // Operators can create/update trips assigned to them. Admins have global access.
      allow create: if isOperator() && (
        request.resource.data.operatorId == request.auth.uid || isAdmin()
      );

      allow update: if isOperator() && (
        resource.data.operatorId == request.auth.uid || isAdmin()
      );

      allow delete: if isAdmin();
    }

    // ─── bookings/{bookingId} ─────────────────────────────────────────────
    match /bookings/{bookingId} {
      // Travelers read their own bookings;
      // Operators read bookings for tours they manage; Admins read all.
      allow read: if isAuthenticated() && (
        resource.data.userId == request.auth.uid ||
        (isOperator() && resource.data.operatorId == request.auth.uid) ||
        isAdmin()
      );

      // Travelers can create their own booking with initial 'Pending' state
      allow create: if isAuthenticated() &&
        request.resource.data.userId == request.auth.uid &&
        request.resource.data.status == 'Pending';

      // Operators can update permitted status & payment on bookings for their tours;
      // Admins can update any booking.
      allow update: if (isOperator() && resource.data.operatorId == request.auth.uid) || isAdmin();

      // Only Admins can delete booking records
      allow delete: if isAdmin();
    }

    // ─── community_posts/{postId} ─────────────────────────────────────────
    match /community_posts/{postId} {
      // Anyone authenticated can read community posts
      allow read: if isAuthenticated();

      // Any authenticated explorer can create a post
      allow create: if isAuthenticated() && request.resource.data.userId == request.auth.uid;

      // Author can edit; Moderators and Admins can moderate/hide/update
      allow update: if (isAuthenticated() && resource.data.userId == request.auth.uid) || isModerator();

      // Author, Moderator, or Admin can delete
      allow delete: if (isAuthenticated() && resource.data.userId == request.auth.uid) || isModerator();
    }

    // ─── moderation_reports/{reportId} ────────────────────────────────────
    match /moderation_reports/{reportId} {
      // Any authenticated user can submit a report against inappropriate content
      allow create: if isAuthenticated() && request.resource.data.reporterId == request.auth.uid;

      // Only Moderators and Admins can view, review, and act on reports
      allow read, update, delete: if isModerator();
    }

    // ─── admin_audit_logs/{logId} ─────────────────────────────────────────
    match /admin_audit_logs/{logId} {
      // Only Admins can inspect the immutable audit log trail
      allow read: if isAdmin();

      // Staff (Operators, Moderators, Admins) can append audit records
      allow create: if isOperator() || isModerator() || isAdmin();

      // Audit logs are append-only and cannot be altered or removed
      allow update, delete: if false;
    }

    // ─── content/{contentId} ──────────────────────────────────────────────
    match /content/{contentId} {
      allow read: if isAuthenticated();
      allow create, update, delete: if isOperator() || isModerator() || isAdmin();
    }
  }
}
